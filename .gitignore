# Node
node_modules/

# Environment / Secrets
.env
.env.*
*.log

# Local databases
data/*.db
data/*.db-shm
data/*.db-wal

# Excel activity reports
data/*.xlsx

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Runtime files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
